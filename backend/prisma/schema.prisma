generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  nickname          String?

  emailVerified Boolean   @default(false)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  conversations Conversation[]
  notes         Note[]
  attachments   Attachment[]

  /// 唯一账号标识，用于 @handle 展示与搜索。
  /// 可空：表里已有数据，非空加唯一约束会直接迁移失败
  /// （Postgres 的唯一索引允许多个 NULL，所以不影响唯一性）。
  /// 展示时为空则回退到邮箱前缀。
  handle String? @unique
  /// 个性签名 / 职位
  bio    String?

  friendships     ChatFriendship[]           @relation("ChatFriendshipOwner")
  friendOf        ChatFriendship[]           @relation("ChatFriendshipTarget")
  chatMemberships ChatConversationMember[]
  chatMessages    ChatMessage[]
  chatAttachments ChatAttachment[]
  /// 自己创建的群聊（ownerId）。与 chatMemberships 是两回事：
  /// 那条是「我在哪些会话里」，这条是「哪些群是我建的」
  ownedChatConversations ChatConversation[] @relation("ChatConversationOwner")
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  title     String?
  model     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  messages  Message[]
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId, updatedAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String // system | user | assistant | tool
  content        String
  toolCalls      Json?
  toolCallId     String?
  name           String?
  usage          Json?
  createdAt      DateTime @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

/// 笔记：Markdown 正文 + 附件
model Note {
  id        String    @id @default(cuid())
  userId    String
  title     String    @default("无标题")
  content   String    @default("") // Markdown 原文
  /// 手动置顶，列表排序时优先于 updatedAt
  pinned    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// 软删除：列表查询一律带 deletedAt: null
  deletedAt DateTime?

  /// 父页面。为空即顶层页面。子页面自身也可以再有子页面（同一套结构）。
  parentId String?

  user        User         @relation(fields: [userId], references: [id])
  /// 自关联。onDelete: Cascade 只是数据库层的兜底 —— 业务上走软删除
  /// （只写 deletedAt），级联不会触发，子树软删除由 NotesService 显式处理。
  parent   Note?  @relation("NoteTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Note[] @relation("NoteTree")

  attachments Attachment[]

  /// RAG 切块（见 NoteChunk）
  chunks      NoteChunk[]

  @@index([userId, deletedAt, updatedAt])
  @@index([parentId])
}

/// 附件：PDF 等文件，实体存磁盘，库里只留元数据
model Attachment {
  id     String  @id @default(cuid())
  userId String
  /// 允许独立上传（笔记尚未保存时先传文件），故可空
  noteId String?

  /// 用户看到的原始文件名
  filename   String
  mimeType   String
  /// 字节数
  size       Int
  /// 磁盘上的实际文件名（随机串 + 扩展名），避免同名覆盖与路径穿越
  storageKey String @unique

  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id])
  note Note? @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([noteId])
}

/// 笔记切块 + 向量：RAG 检索的底座。一篇笔记切成若干块，每块一行。
///
/// 为什么不用 pgvector：本机 Postgres 是便携版、没装该扩展，而 Windows 上
/// pgvector 没有官方预编译包（要么编 C++，要么换 Docker 镜像）。实测在 Node 里
/// 暴力算余弦（1024 维）2 万条只要 35ms —— 个人笔记到不了这个量级，
/// 所以向量直接存二进制、检索时在内存里算，零新依赖。
/// 等到向量超过 10 万条、或需要在 SQL 层做「向量 + 业务条件」联合过滤时再迁。
model NoteChunk {
  id        String   @id @default(cuid())
  noteId    String
  /// 检索必须按它过滤，否则会把别人的笔记块召回给当前用户
  userId    String
  /// 块在笔记内的序号，出问题时用于回溯定位
  seq       Int
  /// 块所属的小节标题，会和正文拼在一起送去编码 ——
  /// 脱离上下文的块要靠它才被正确理解
  title     String
  /// 块正文
  content   String
  /// 向量：Float32Array 的原始字节（1024 维 = 4096 字节）。
  /// 不用数字数组，是因为那个要序列化成 JSON 文本，体积是二进制的 3~5 倍
  embedding Bytes
  createdAt DateTime @default(now())

  /// 笔记走软删除，Cascade 不会触发，所以检索时还要 join 回来过滤 deletedAt
  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@index([userId])
}

/* ==================================================================== */
/* 聊天模块                                                              */
/*                                                                       */
/* 模型名统一加 Chat 前缀：Conversation / Message 已被 AI 助手模块占用，   */
/* 而 Prisma 的模型与枚举都在同一命名空间，重名会直接报 Duplicate model。 */
/* ==================================================================== */

/// 好友关系。每人一行：A 加 B 会写 (A,B) 与 (B,A) 两条，双向可见
model ChatFriendship {
  id        String   @id @default(cuid())
  userId    String
  friendId  String
  /// 备注名，为空时展示对方的 nickname
  alias     String?
  createdAt DateTime @default(now())

  user   User @relation("ChatFriendshipOwner", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("ChatFriendshipTarget", fields: [friendId], references: [id], onDelete: Cascade)

  /// 同一个好友只能加一次
  @@unique([userId, friendId])
  @@index([friendId])
}

enum ChatConversationKind {
  DIRECT
  GROUP
}

model ChatConversation {
  id        String               @id @default(cuid())
  kind      ChatConversationKind
  /// 群聊的群名。单聊为 null，标题由前端按对方名字推导
  title     String?
  /// 群聊创建者，用于权限判断
  ownerId   String?
  /// 单聊去重键：两个成员 id 排序后 ':' 连接。群聊为 null。
  /// 靠唯一约束去重，而不是「先查再建」—— 后者在并发下有窗口
  directKey String?              @unique
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  /// 群主。`onDelete: SetNull` 而不是 Cascade ——
  /// 群聊还有其他成员，删一个人不该把整个群连带删了；
  /// 也不能 Restrict，那会让「删用户」被历史群聊卡住。
  owner    User?                  @relation("ChatConversationOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  members  ChatConversationMember[]
  messages ChatMessage[]

  @@index([updatedAt])
}

/// 会话成员。把「置顶 / 免打扰 / 未读」放在成员维度而不是会话维度 ——
/// 这些是每个人自己的状态，放会话上会导致 A 读了消息、B 的未读数也被清零
model ChatConversationMember {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  pinned         Boolean   @default(false)
  muted          Boolean   @default(false)
  unread         Int       @default(0)
  /// 最后已读的时间，用于算未读与已读回执
  lastReadAt     DateTime?
  joinedAt       DateTime  @default(now())
  /// 退出 / 被移出群聊的时间；为 null 表示仍在群里
  leftAt         DateTime?

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, pinned])
}

enum ChatMessageKind {
  TEXT
  IMAGE
  FILE
  NOTE
}

enum ChatMessageStatus {
  SENT
  READ
}

model ChatMessage {
  id             String            @id @default(cuid())
  conversationId String
  senderId       String
  kind           ChatMessageKind
  /// 文本内容；附件与笔记卡片也可以带一句说明
  text           String?
  /// 分享的笔记快照（只存 id / 标题 / 类型 / 子页面数，不存正文）。
  /// 存快照而不是每次联表：聊天记录是历史，笔记后来改名不该改写历史；
  /// 而且列表一屏几百条，每条都 join 笔记表会变成 N+1
  noteId         String?
  noteTitle      String?
  noteKind       String?
  noteChildCount Int               @default(0)
  status         ChatMessageStatus @default(SENT)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User             @relation(fields: [senderId], references: [id])
  /// 一个附件只属于一条消息
  attachment   ChatAttachment?

  /// 拉历史消息按 (会话, 时间倒序) 分页，这个复合索引是必需的
  @@index([conversationId, createdAt])
}

/// 聊天附件。与笔记的 Attachment 分表：
/// 两者生命周期不同（删笔记不该删聊天记录里的文件），混在一张表会互相牵连
model ChatAttachment {
  id         String   @id @default(cuid())
  /// 可空！上传与发送是两步：先 POST /chat/attachments 拿 id，
  /// 再带 attachmentId 发消息时才建立关联。非空约束会让第一步插不进去。
  /// 代价是会产生「传了没发」的孤儿附件，需要定时清理
  messageId  String?  @unique
  uploaderId String
  filename   String
  /// 存储相对路径。文件名用随机 UUID + 扩展名，杜绝路径穿越与同名覆盖
  storageKey String   @unique
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())

  message  ChatMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploader User         @relation(fields: [uploaderId], references: [id])

  /// 清理孤儿附件（上传了但没发出去）要靠这个索引
  @@index([uploaderId, createdAt])
}
